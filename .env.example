# --- App ---
PORT=5050

# --- PostgreSQL (docker compose up -d) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notification_db?schema=public"

# --- Redis (BullMQ queues, provider rate limiting, cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_TTL=300
REDIS_MAX_ITEMS=100

# --- HTTP throttling ---
THROTTLER_TTL=60
THROTTLER_LIMIT=100

# --- SendGrid (email) ---
SENDGRID_API_KEY=SG.your_key_here
SENDGRID_SENDER_EMAIL=you@yourdomain.com

# --- Twilio (SMS / OTP) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+10000000000

# --- Per-provider outbound rate limits (requests/second, enforced via Redis) ---
SENDGRID_RATE_LIMIT_PER_SEC=10
TWILIO_RATE_LIMIT_PER_SEC=5
